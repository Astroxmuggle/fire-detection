# FireWatch AI configuration template.
# Copy to ".env" and edit. Real environment variables always win over this file.

# ------------------------------------------------------------------ runtime
DEBUG=False
SECRET_KEY=change-this-secret-key
HOST=127.0.0.1
PORT=5000
LOGGING_LEVEL=INFO

# ------------------------------------------------------------------ storage
# DATABASE_PATH=C:\path\to\fire_detection.db
# EVIDENCE_DIR=C:\path\to\snapshots
# LOG_DIR=C:\path\to\logs

# -------------------------------------------------------------------- model
# Default is the checkpoint bundled with the repository.
# MODEL_PATH=C:\path\to\best.pt

# ------------------------------------------------------------------- camera
# Webcam index ("0") or any OpenCV source: rtsp://user:pass@host:554/stream, or a video file.
CAMERA_SOURCE=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# ---------------------------------------------------------------- detection
CONFIDENCE_THRESHOLD=0.50
FIRE_CONFIDENCE_THRESHOLD=0.50
SMOKE_CONFIDENCE_THRESHOLD=0.55
IOU_THRESHOLD=0.40

# Reject boxes smaller than this fraction of the frame (sensor noise) and
# boxes larger than the maximum (full-frame blobs are almost always artefacts).
MIN_BOX_AREA_RATIO=0.0004
MAX_BOX_AREA_RATIO=0.92

# Frames whose grayscale standard deviation is below this are treated as blank
# (covered lens, dark room, uniform wall) and are never sent to the model.
MIN_FRAME_STD=6.0

# Temporal confirmation: N consecutive frames to raise an alarm, M frames
# without the class before it can raise again, and a hard cool-down in seconds.
CONFIRMATION_FRAMES=2
CONFIRMATION_RELEASE_FRAMES=3
CONFIRMATION_COOLDOWN=5.0

# ----------------------------------------------------------------- alerting
ALERT_COOLDOWN=60
ALERT_SOUND_ENABLED=True

# --------------------------------------------------------------------- misc
STREAM_JPEG_QUALITY=70
EVENT_RETENTION_DAYS=0
